#!name=Telegram 跳转
#!desc=将 t.me 链接跳转到指定 Telegram 客户端
#!category=IAUN
#!arguments=客户端=Telegram

[Script]
TelegramRedirect = type=http-request,pattern=^https?://t\.me/.+,script-path=https://raw.githubusercontent.com/X-IAUN/Surge-module/main/TgRedirect.js,argument=客户端={{{客户端}}},timeout=5

[MITM]
hostname = %APPEND% t.me
