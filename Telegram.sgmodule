#!name=Telegram 跳转
#!desc=将 t.me 链接跳转到指定 Telegram 客户端
#!category=IAUN
#!arguments=CLIENT:Telegram

[Script]
TelegramRedirect = type=http-request,pattern=^https?://(t\.me|telegram\.me)/.+,script-path=https://raw.githubusercontent.com/X-IAUN/Surge-module/main/TgRedirect.js,argument=CLIENT={{{CLIENT}}},timeout=10

[MITM]
hostname = %APPEND% t.me, telegram.me
